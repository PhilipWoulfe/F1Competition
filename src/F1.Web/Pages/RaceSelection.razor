@page "/selection"
@page "/selection/{RaceId}"
@page "/selection/{Competition}/{Season:int}/round/{Round:int}"
@page "/selection/{Competition}/{Season:int}/{RaceSlug}"
@page "/yas-marina-selection"
@using F1.Web.Configuration
@using F1.Web.Models
@using F1.Web.Services.Api
@implements IAsyncDisposable
@inject ISelectionPageService SelectionPageService
@inject IRaceContextApiService RaceContextApiService
@inject ISelectionCountdownFormatter CountdownFormatter
@inject F1.Web.Services.ITimeProvider TimeProvider
@inject F1.Web.Services.IMockDateService MockDateService
@inject NavigationManager Navigation

<h1>@GetPageTitle()</h1>

@if (!string.IsNullOrWhiteSpace(routeContextErrorMessage))
{
    <p role="alert" class="text-danger">@routeContextErrorMessage</p>
}
else if (drivers is null || raceConfig is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <SelectionStatusBanners
        ErrorMessage="@errorMessage"
        SuccessMessage="@successMessage"
        RaceMetadata="@raceMetadata"
        CountdownText="@GetCountdownText()"
        LockingMessage="@GetLockingMessage()" />

    <EditForm Model="formModel" OnValidSubmit="SaveSelectionAsync">
        <DriverSelectionList Drivers="@drivers" SelectedDriverIds="@formModel.SelectedDriverIds" IsReadOnly="@isReadOnly" />

        <BetStrategySelector
            Value="@formModel.SelectedBetType"
            ValueChanged="OnBetTypeChanged"
            ValueExpression="@(() => formModel.SelectedBetType)"
            IsReadOnly="@isReadOnly" />

        <button id="submit-selection" class="btn btn-primary" type="submit" disabled="@isReadOnly">Save Selection</button>

        @if (isReadOnly)
        {
            <p class="text-muted mt-2">This pre-qualy selection is locked.</p>
        }
    </EditForm>
}

@code {
    [Parameter] public string? RaceId { get; set; }
    [Parameter] public string? Competition { get; set; }
    [Parameter] public int? Season { get; set; }
    [Parameter] public int? Round { get; set; }
    [Parameter] public string? RaceSlug { get; set; }

    private Driver[]? drivers;
    private RaceConfig? raceConfig;
    private RaceQuestionMetadata? raceMetadata;
    private readonly SelectionFormModel formModel = new();
    private string? errorMessage;
    private string? successMessage;
    private bool isReadOnly;
    private PeriodicTimer? countdownTimer;
    private CancellationTokenSource? timerCts;
    private Task? tickTask;
    private string? loadedRaceId;
    private string? loadedContextKey;
    private string? routeContextErrorMessage;

    protected override async Task OnParametersSetAsync()
    {
        if (!TryResolveRouteContext(out var routeContext))
        {
            loadedContextKey = null;
            loadedRaceId = null;
            drivers = null;
            raceConfig = null;
            raceMetadata = null;
            isReadOnly = false;
            return;
        }

        StartCountdownTimerIfNeeded();

        if (string.Equals(loadedContextKey, routeContext.ContextKey, StringComparison.Ordinal))
        {
            return;
        }

        var activeRaceId = await ResolveRaceIdAsync(routeContext);
        loadedContextKey = routeContext.ContextKey;
        if (string.IsNullOrWhiteSpace(activeRaceId))
        {
            loadedRaceId = null;
            drivers = null;
            raceConfig = null;
            raceMetadata = null;
            isReadOnly = false;
            return;
        }

        routeContextErrorMessage = null;
        loadedRaceId = activeRaceId;
        await MockDateService.RefreshAsync();
        await LoadDataAsync(activeRaceId);
    }

    public async ValueTask DisposeAsync()
    {
        var cts = timerCts;
        var timer = countdownTimer;
        var task = tickTask;
        timerCts = null;
        countdownTimer = null;
        tickTask = null;

        if (cts is not null)
        {
            await cts.CancelAsync();
        }

        if (task is not null)
        {
            await task;
        }

        cts?.Dispose();
        timer?.Dispose();
    }

    private async Task LoadDataAsync(string activeRaceId)
    {
        errorMessage = null;
        successMessage = null;

        try
        {
            var loaded = await SelectionPageService.LoadAsync(activeRaceId, formModel.SelectedDriverIds.Count, TimeProvider.UtcNow);
            drivers = loaded.Drivers;
            raceConfig = loaded.RaceConfig;
            raceMetadata = loaded.RaceMetadata;
            ApplyState(loaded.State);
        }
        catch (ApiServiceException ex)
        {
            errorMessage = $"Error loading data: {ex.Error.Message}";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading data: {ex.Message}";
        }
    }

    private async Task SaveSelectionAsync()
    {
        errorMessage = null;
        successMessage = null;

        if (!TryResolveRouteContext(out var routeContext))
        {
            return;
        }

        var activeRaceId = loadedRaceId;
        if (string.IsNullOrWhiteSpace(activeRaceId))
        {
            activeRaceId = await ResolveRaceIdAsync(routeContext);
            if (string.IsNullOrWhiteSpace(activeRaceId))
            {
                return;
            }
        }

        try
        {
            var saved = await SelectionPageService.SaveAsync(activeRaceId, formModel);
            successMessage = "Selection saved successfully.";
            ApplyState(saved.State);
        }
        catch (ApiServiceException ex)
        {
            errorMessage = SelectionPageService.GetSaveErrorMessage(ex);
        }
        catch (Exception)
        {
            errorMessage = "Unable to save selection.";
        }
    }

    private Task OnBetTypeChanged(BetType betType)
    {
        formModel.SelectedBetType = betType;
        return Task.CompletedTask;
    }

    private void ApplyState(SelectionPageState state)
    {
        formModel.SelectedBetType = state.SelectedBetType;

        for (var i = 0; i < formModel.SelectedDriverIds.Count; i++)
        {
            formModel.SelectedDriverIds[i] = i < state.SelectedDriverIds.Count ? state.SelectedDriverIds[i] : string.Empty;
        }

        isReadOnly = state.IsReadOnly;
    }

    private string GetCountdownText()
    {
        return CountdownFormatter.FormatCountdown(raceConfig, TimeProvider.UtcNow);
    }

    private string GetPageTitle()
    {
        if (!string.IsNullOrWhiteSpace(raceMetadata?.DisplayTitle))
        {
            return raceMetadata.DisplayTitle;
        }

        return "Race Selection";
    }

    private string GetLockingMessage()
    {
        if (!string.IsNullOrWhiteSpace(raceMetadata?.LockMessage))
        {
            return raceMetadata.LockMessage;
        }

        if (raceConfig is null)
        {
            return "Locking for Pre-Qualy gives +50% points and prevents changes after the configured lock deadline.";
        }

        var lockTimeText = raceConfig.PreQualyDeadlineUtc
            .ToString("dd MMM yyyy HH:mm 'UTC'", System.Globalization.CultureInfo.InvariantCulture);

        return $"Locking for Pre-Qualy gives +50% points and prevents changes after {lockTimeText}.";
    }

    private void StartCountdownTimerIfNeeded()
    {
        if (countdownTimer is not null)
        {
            return;
        }

        timerCts = new CancellationTokenSource();
        countdownTimer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        tickTask = TickCountdownAsync(timerCts.Token);
    }

    private bool TryResolveRouteContext(out RaceSelectionContext routeContext)
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
        var success = RaceSelectionRouteResolver.TryResolve(RaceId, Competition, Season, Round, RaceSlug, relativePath, out var resolved, out var errorMessage);
        if (!success || resolved is null)
        {
            routeContextErrorMessage = errorMessage;
            routeContext = new RaceSelectionContext { ContextKey = "invalid" };
            return false;
        }

        routeContextErrorMessage = null;
        routeContext = resolved;
        return true;
    }

    private async Task<string?> ResolveRaceIdAsync(RaceSelectionContext routeContext)
    {
        if (!string.IsNullOrWhiteSpace(routeContext.RaceId))
        {
            return routeContext.RaceId;
        }

        var lookup = routeContext.Lookup;
        if (lookup is null)
        {
            routeContextErrorMessage = "Race context is invalid.";
            return null;
        }

        var parsedRound = 0;
        if (lookup.LookupType == RaceRouteLookupType.Round
            && !int.TryParse(lookup.LookupValue, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out parsedRound))
        {
            routeContextErrorMessage = "Race context is invalid. Round must be numeric.";
            return null;
        }

        RaceContextResolution? resolved;
        try
        {
            resolved = lookup.LookupType == RaceRouteLookupType.Round
                ? await RaceContextApiService.ResolveByRoundAsync(lookup.CompetitionSlug, lookup.Season, parsedRound)
                : await RaceContextApiService.ResolveBySlugAsync(lookup.CompetitionSlug, lookup.Season, lookup.LookupValue);
        }
        catch (ApiServiceException ex)
        {
            routeContextErrorMessage = $"Unable to resolve race context: {ex.Error.Message}";
            return null;
        }
        catch (Exception ex)
        {
            routeContextErrorMessage = $"Unable to resolve race context: {ex.Message}";
            return null;
        }

        if (resolved is null)
        {
            routeContextErrorMessage = "No race found for the requested competition, season, and race context.";
            return null;
        }

        return resolved.RaceId;
    }

    private async Task TickCountdownAsync(CancellationToken cancellationToken)
    {
        var timer = countdownTimer;
        if (timer is null)
        {
            return;
        }

        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Unexpected error in countdown timer: {ex}");
        }
    }
}