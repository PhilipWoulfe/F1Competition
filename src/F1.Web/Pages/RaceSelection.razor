@page "/selection"
@page "/selection/{RaceId}"
@page "/selection/{Competition}/{Season:int}/round/{Round:int}"
@page "/selection/{Competition}/{Season:int}/{RaceSlug}"
@using F1.Web.Configuration
@using F1.Web.Models
@using F1.Web.Services.Api
@implements IAsyncDisposable
@inject ISelectionPageService SelectionPageService
@inject IRaceContextApiService RaceContextApiService
@inject ISelectionCountdownFormatter CountdownFormatter
@inject ISelectionContextService SelectionContextService
@inject F1.Web.Services.ITimeProvider TimeProvider
@inject F1.Web.Services.IMockDateService MockDateService
@inject NavigationManager Navigation

<h1>@GetPageTitle()</h1>

@if (availableContexts.Count > 0)
{
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label class="form-label" for="selection-context-competition">Competition</label>
                    <select id="selection-context-competition" class="form-select" value="@selectedCompetitionSlug" @onchange="OnCompetitionChangedAsync">
                        @foreach (var competition in GetCompetitionOptions())
                        {
                            <option value="@competition.CompetitionSlug">@competition.GetCompetitionLabel()</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="selection-context-season">Season</label>
                    <select id="selection-context-season" class="form-select" value="@GetSelectedSeasonValue()" @onchange="OnSeasonChangedAsync">
                        @foreach (var context in GetSeasonOptions())
                        {
                            <option value="@context.Season">@context.Season</option>
                        }
                    </select>
                </div>
            </div>
            @if (GetSelectedContext() is { } selectedContext)
            {
                <div class="text-muted small mt-2">Current context: @selectedContext.DisplayLabel</div>
            }
        </div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(routeContextErrorMessage))
{
    <p role="alert" class="text-danger">@routeContextErrorMessage</p>
}
else if (!string.IsNullOrWhiteSpace(errorMessage) && (drivers is null || raceConfig is null))
{
    <p role="alert" class="text-danger">@errorMessage</p>
}
else if (drivers is null || raceConfig is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <SelectionStatusBanners
        ErrorMessage="@errorMessage"
        SuccessMessage="@successMessage"
        RaceMetadata="@raceMetadata"
        CountdownText="@GetCountdownText()"
        LockingMessage="@GetLockingMessage()" />

    <EditForm Model="formModel" OnValidSubmit="SaveSelectionAsync">
        <DriverSelectionList Drivers="@drivers" SelectedDriverIds="@formModel.SelectedDriverIds" SelectionCount="@formModel.SelectedDriverIds.Count" IsReadOnly="@isReadOnly" />

        <BetStrategySelector
            Value="@formModel.SelectedBetType"
            ValueChanged="OnBetTypeChanged"
            ValueExpression="@(() => formModel.SelectedBetType)"
            Options="@raceConfig.BetOptions"
            IsReadOnly="@isReadOnly" />

        <button id="submit-selection" class="btn btn-primary" type="submit" disabled="@isReadOnly">Save Selection</button>

        @if (isReadOnly)
        {
            <p class="text-muted mt-2">@GetReadOnlyMessage()</p>
        }
    </EditForm>
}

@code {
    [Parameter] public string? RaceId { get; set; }
    [Parameter] public string? Competition { get; set; }
    [Parameter] public int? Season { get; set; }
    [Parameter] public int? Round { get; set; }
    [Parameter] public string? RaceSlug { get; set; }

    private Driver[]? drivers;
    private RaceConfig? raceConfig;
    private RaceQuestionMetadata? raceMetadata;
    private readonly SelectionFormModel formModel = new();
    private string? errorMessage;
    private string? successMessage;
    private bool isReadOnly;
    private PeriodicTimer? countdownTimer;
    private CancellationTokenSource? timerCts;
    private Task? tickTask;
    private string? loadedRaceId;
    private string? loadedContextKey;
    private string? routeContextErrorMessage;
    private IReadOnlyList<SelectionContextOption> availableContexts = [];
    private string? selectedCompetitionSlug;
    private int? selectedSeason;

    protected override void OnInitialized()
    {
        availableContexts = SelectionContextService.GetAvailableContexts();
        var defaultContext = SelectionContextService.GetDefaultContext();
        selectedCompetitionSlug = defaultContext.CompetitionSlug;
        selectedSeason = defaultContext.Season;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (availableContexts.Count == 0)
        {
            routeContextErrorMessage = "No competition contexts are configured.";
            return;
        }

        if (!HasExplicitRouteContext())
        {
            await RestoreSelectionContextAsync();
            return;
        }

        if (!TryResolveRouteContext(out var routeContext))
        {
            loadedContextKey = null;
            loadedRaceId = null;
            drivers = null;
            raceConfig = null;
            raceMetadata = null;
            isReadOnly = false;
            return;
        }

        StartCountdownTimerIfNeeded();

        if (string.Equals(loadedContextKey, routeContext.ContextKey, StringComparison.Ordinal))
        {
            return;
        }

        var activeRaceId = await ResolveRaceIdAsync(routeContext);
        loadedContextKey = routeContext.ContextKey;
        if (string.IsNullOrWhiteSpace(activeRaceId))
        {
            loadedRaceId = null;
            drivers = null;
            raceConfig = null;
            raceMetadata = null;
            isReadOnly = false;
            return;
        }

        routeContextErrorMessage = null;
        loadedRaceId = activeRaceId;
        if (SelectionContextService.ResolveContext(routeContext, activeRaceId) is { } resolvedContext)
        {
            SetSelectedContext(resolvedContext);
            await SelectionContextService.SaveLastUsedAsync(resolvedContext);
        }

        await MockDateService.RefreshAsync();
        await LoadDataAsync(activeRaceId);
    }

    public async ValueTask DisposeAsync()
    {
        var cts = timerCts;
        var timer = countdownTimer;
        var task = tickTask;
        timerCts = null;
        countdownTimer = null;
        tickTask = null;

        if (cts is not null)
        {
            await cts.CancelAsync();
        }

        if (task is not null)
        {
            await task;
        }

        cts?.Dispose();
        timer?.Dispose();
    }

    private async Task LoadDataAsync(string activeRaceId)
    {
        // Prevent stale race data/submission when route switches and next load fails.
        drivers = null;
        raceConfig = null;
        raceMetadata = null;
        formModel.SelectedDriverIds.Clear();
        formModel.SelectedBetType = BetType.Regular;
        isReadOnly = false;
        errorMessage = null;
        successMessage = null;

        await InvokeAsync(StateHasChanged);

        try
        {
            var loaded = await SelectionPageService.LoadAsync(activeRaceId, TimeProvider.UtcNow);
            drivers = loaded.Drivers;
            raceConfig = loaded.RaceConfig;
            raceMetadata = loaded.RaceMetadata;
            ApplyState(loaded.State);
        }
        catch (ApiServiceException ex)
        {
            if (ex.Error.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                errorMessage = $"No race found for race token '{activeRaceId}'.";
                return;
            }

            errorMessage = $"Error loading data: {ex.Error.Message}";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading data: {ex.Message}";
        }
    }

    private async Task SaveSelectionAsync()
    {
        errorMessage = null;
        successMessage = null;

        if (!TryResolveRouteContext(out var routeContext))
        {
            return;
        }

        var activeRaceId = loadedRaceId;
        if (string.IsNullOrWhiteSpace(activeRaceId))
        {
            activeRaceId = await ResolveRaceIdAsync(routeContext);
            if (string.IsNullOrWhiteSpace(activeRaceId))
            {
                return;
            }
        }

        try
        {
            var saved = await SelectionPageService.SaveAsync(activeRaceId, formModel);
            successMessage = "Selection saved successfully.";
            ApplyState(saved.State);
        }
        catch (ApiServiceException ex)
        {
            errorMessage = SelectionPageService.GetSaveErrorMessage(ex);
        }
        catch (Exception)
        {
            errorMessage = "Unable to save selection.";
        }
    }

    private Task OnBetTypeChanged(BetType betType)
    {
        formModel.SelectedBetType = betType;
        return Task.CompletedTask;
    }

    private void ApplyState(SelectionPageState state)
    {
        formModel.EnsureSelectionCount(state.SelectedDriverIds.Count);
        formModel.SelectedBetType = state.SelectedBetType;

        for (var i = 0; i < formModel.SelectedDriverIds.Count; i++)
        {
            formModel.SelectedDriverIds[i] = i < state.SelectedDriverIds.Count ? state.SelectedDriverIds[i] : string.Empty;
        }

        isReadOnly = state.IsReadOnly;
    }

    private string GetCountdownText()
    {
        return CountdownFormatter.FormatCountdown(raceConfig, TimeProvider.UtcNow);
    }

    private string GetPageTitle()
    {
        if (!string.IsNullOrWhiteSpace(raceMetadata?.DisplayTitle))
        {
            return raceMetadata.DisplayTitle;
        }

        return "Race Selection";
    }

    private string GetLockingMessage()
    {
        if (!string.IsNullOrWhiteSpace(raceMetadata?.LockMessage))
        {
            return raceMetadata.LockMessage;
        }

        return raceConfig?.LockMessage
            ?? "Locking for Pre-Qualy gives +50% points and prevents changes after the configured lock deadline.";
    }

    private string GetReadOnlyMessage()
    {
        return raceConfig?.LockedSelectionMessage ?? "This pre-qualy selection is locked.";
    }

    private void StartCountdownTimerIfNeeded()
    {
        if (countdownTimer is not null)
        {
            return;
        }

        timerCts = new CancellationTokenSource();
        countdownTimer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        tickTask = TickCountdownAsync(timerCts.Token);
    }

    private bool HasExplicitRouteContext()
    {
        return !string.IsNullOrWhiteSpace(RaceId)
            || !string.IsNullOrWhiteSpace(Competition)
            || Season.HasValue
            || Round.HasValue
            || !string.IsNullOrWhiteSpace(RaceSlug);
    }

    private async Task RestoreSelectionContextAsync()
    {
        loadedContextKey = null;
        loadedRaceId = null;
        drivers = null;
        raceConfig = null;
        raceMetadata = null;
        isReadOnly = false;
        routeContextErrorMessage = null;

        var restoredContext = await SelectionContextService.GetRestoredOrDefaultAsync();
        SetSelectedContext(restoredContext);
        Navigation.NavigateTo(SelectionContextService.BuildSelectionPath(restoredContext), replace: true);
    }

    private async Task OnCompetitionChangedAsync(ChangeEventArgs args)
    {
        var competitionSlug = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(competitionSlug))
        {
            return;
        }

        selectedCompetitionSlug = competitionSlug;
        var nextContext = GetSelectedContext() ?? GetSeasonOptions().FirstOrDefault();
        if (nextContext is null)
        {
            return;
        }

        SetSelectedContext(nextContext);
        await NavigateToContextAsync(nextContext);
    }

    private async Task OnSeasonChangedAsync(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var season))
        {
            return;
        }

        selectedSeason = season;
        var nextContext = GetSelectedContext();
        if (nextContext is null)
        {
            return;
        }

        await NavigateToContextAsync(nextContext);
    }

    private async Task NavigateToContextAsync(SelectionContextOption context)
    {
        SetSelectedContext(context);
        await SelectionContextService.SaveLastUsedAsync(context);

        var targetPath = SelectionContextService.BuildSelectionPath(context);
        var currentPath = new Uri(Navigation.Uri).AbsolutePath;
        if (!string.Equals(currentPath, targetPath, StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo(targetPath);
        }
    }

    private void SetSelectedContext(SelectionContextOption context)
    {
        selectedCompetitionSlug = context.CompetitionSlug;
        selectedSeason = context.Season;
    }

    private SelectionContextOption? GetSelectedContext()
    {
        if (string.IsNullOrWhiteSpace(selectedCompetitionSlug))
        {
            return null;
        }

        return availableContexts.FirstOrDefault(context =>
            string.Equals(context.CompetitionSlug, selectedCompetitionSlug, StringComparison.Ordinal)
            && context.Season == selectedSeason);
    }

    private IEnumerable<SelectionContextOption> GetCompetitionOptions()
    {
        return availableContexts
            .GroupBy(context => context.CompetitionSlug, StringComparer.Ordinal)
            .Select(group => group.First())
            .OrderBy(context => context.GetCompetitionLabel(), StringComparer.Ordinal);
    }

    private IEnumerable<SelectionContextOption> GetSeasonOptions()
    {
        if (string.IsNullOrWhiteSpace(selectedCompetitionSlug))
        {
            return Enumerable.Empty<SelectionContextOption>();
        }

        return availableContexts
            .Where(context => string.Equals(context.CompetitionSlug, selectedCompetitionSlug, StringComparison.Ordinal))
            .OrderByDescending(context => context.Season);
    }

    private string GetSelectedSeasonValue()
    {
        return selectedSeason?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;
    }

    private bool TryResolveRouteContext(out RaceSelectionContext routeContext)
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
        var success = RaceSelectionRouteResolver.TryResolve(RaceId, Competition, Season, Round, RaceSlug, relativePath, out var resolved, out var errorMessage);
        if (!success || resolved is null)
        {
            routeContextErrorMessage = errorMessage;
            routeContext = new RaceSelectionContext { ContextKey = "invalid" };
            return false;
        }

        routeContextErrorMessage = null;
        routeContext = resolved;
        return true;
    }

    private async Task<string?> ResolveRaceIdAsync(RaceSelectionContext routeContext)
    {
        if (!string.IsNullOrWhiteSpace(routeContext.RaceId))
        {
            return routeContext.RaceId;
        }

        var lookup = routeContext.Lookup;
        if (lookup is null)
        {
            routeContextErrorMessage = "Race context is invalid.";
            return null;
        }

        var parsedRound = 0;
        if (lookup.LookupType == RaceRouteLookupType.Round
            && !int.TryParse(lookup.LookupValue, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out parsedRound))
        {
            routeContextErrorMessage = "Race context is invalid. Round must be numeric.";
            return null;
        }

        RaceContextResolution? resolved;
        try
        {
            resolved = lookup.LookupType == RaceRouteLookupType.Round
                ? await RaceContextApiService.ResolveByRoundAsync(lookup.CompetitionSlug, lookup.Season, parsedRound)
                : await RaceContextApiService.ResolveBySlugAsync(lookup.CompetitionSlug, lookup.Season, lookup.LookupValue);
        }
        catch (ApiServiceException ex)
        {
            routeContextErrorMessage = $"Unable to resolve race context: {ex.Error.Message}";
            return null;
        }
        catch (Exception ex)
        {
            routeContextErrorMessage = $"Unable to resolve race context: {ex.Message}";
            return null;
        }

        if (resolved is null)
        {
            routeContextErrorMessage = "No race found for the requested competition, season, and race context.";
            return null;
        }

        return resolved.RaceId;
    }

    private async Task TickCountdownAsync(CancellationToken cancellationToken)
    {
        var timer = countdownTimer;
        if (timer is null)
        {
            return;
        }

        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Unexpected error in countdown timer: {ex}");
        }
    }
}