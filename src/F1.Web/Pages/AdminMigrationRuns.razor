    private IEnumerable<AdminMigrationPickDiff> GetFilteredPickDiffs()
    {
        if (selectedRunDetail is null)
        {
            return Enumerable.Empty<AdminMigrationPickDiff>();
        }

        return selectedRunDetail.PickDiffs
            .Where(row => MatchesFilter(row.Subject, detailParticipantFilter))
            .Where(row => MatchesFilter(row.RaceCode, detailRaceFilter))
            .Where(row => MatchesFilter(row.ReasonCode, detailReasonFilter))
            .Where(row => !detailNonZeroOnly || row.DeltaPoints != 0);
    }

    private static bool MatchesFilter(string? value, string filter)
    {
        if (string.IsNullOrWhiteSpace(filter))
        {
            return true;
        }

        return !string.IsNullOrWhiteSpace(value) &&
               value.Contains(filter.Trim(), StringComparison.OrdinalIgnoreCase);
    }

    private static string GetVarianceStatusText(bool isExpectedVariance, int deltaPoints)
    {
        if (deltaPoints == 0)
        {
            return "No variance";
        }

        return isExpectedVariance ? "Expected" : "Unexpected";
    }

    private static string GetVarianceBadgeClass(bool isExpectedVariance, int deltaPoints)
    {
        if (deltaPoints == 0)
        {
            return "badge bg-secondary";
        }

        return isExpectedVariance ? "badge bg-success" : "badge bg-warning text-dark";
    }

    private static string GetRunStatusBadgeClass(string? status)
    {
        if (string.Equals(status, "Completed", StringComparison.OrdinalIgnoreCase))
        {
            return "badge bg-success";
        }

        if (string.Equals(status, "Failed", StringComparison.OrdinalIgnoreCase))
        {
            return "badge bg-danger";
        }

        if (string.Equals(status, "Started", StringComparison.OrdinalIgnoreCase))
        {
            return "badge bg-primary";
        }

        if (string.Equals(status, "Queued", StringComparison.OrdinalIgnoreCase))
        {
            return "badge bg-secondary";
        }

        return "badge bg-secondary";
    }

    private static string GetRunModeBadgeClass(bool isDryRun)
    {
        return isDryRun ? "badge bg-secondary" : "badge bg-info text-dark";
    }

    private static string GetUnresolvedTokenBadgeClass(int unresolvedTokenCount)
    {
        if (unresolvedTokenCount > 5)
        {
            return "badge bg-danger";
        }

        return "badge bg-warning text-dark";
    }

    private string GetExportUrl(string exportType, string format)
    {
        if (selectedRunId is null)
        {
            return "#";
        }

        return MigrationRunsApi.GetRunDiffExportUrl(selectedRunId.Value, exportType, format, detailExpectedStatusFilter);
    }

    private async Task<AdminMigrationRunDetailResponse?> LoadRunDetailAsync(Guid runId)
    {
        return string.Equals(detailExpectedStatusFilter, "all", StringComparison.OrdinalIgnoreCase)
            ? await MigrationRunsApi.GetRunDetailAsync(runId)
            : await MigrationRunsApi.GetRunDetailAsync(runId, expectedStatus: detailExpectedStatusFilter);
    }
}
