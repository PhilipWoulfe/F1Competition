@using F1.Web.Models

<h4>Top @SelectionCount Driver Predictions</h4>
@for (var i = 0; i < SelectionCount; i++)
{
    var rank = i;
    <div class="mb-2">
        <label class="form-label">Position @(i + 1)</label>
        <select id="driver-select-@(i + 1)" class="form-select driver-selection" value="@SelectedDriverIds[rank]" @onchange="e => OnDriverChanged(rank, e.Value?.ToString())" disabled="@IsReadOnly">
            <option value="">-- Select driver --</option>
            @foreach (var driver in Drivers)
            {
                <option value="@driver.DriverId">@driver.FullName (@driver.DriverId)</option>
            }
        </select>
    </div>
}

@code {
    [Parameter] public Driver[] Drivers { get; set; } = [];
    [Parameter] public IList<string> SelectedDriverIds { get; set; } = [];
    [Parameter] public int SelectionCount { get; set; } = 5;
    [Parameter] public bool IsReadOnly { get; set; }

    protected override void OnParametersSet()
    {
        if (SelectionCount <= 0)
        {
            SelectionCount = 5;
        }

        if (SelectedDriverIds is null)
        {
            SelectedDriverIds = Enumerable.Repeat(string.Empty, SelectionCount).ToList();
            return;
        }

        if (SelectedDriverIds.Count < SelectionCount)
        {
            if (SelectedDriverIds is List<string> mutable)
            {
                while (mutable.Count < SelectionCount)
                {
                    mutable.Add(string.Empty);
                }
            }
            else
            {
                var normalized = new List<string>(SelectedDriverIds);
                while (normalized.Count < SelectionCount)
                {
                    normalized.Add(string.Empty);
                }

                SelectedDriverIds = normalized;
            }
        }
        else if (SelectedDriverIds.Count > SelectionCount)
        {
            if (SelectedDriverIds is List<string> mutable)
            {
                mutable.RemoveRange(SelectionCount, mutable.Count - SelectionCount);
            }
            else
            {
                SelectedDriverIds = SelectedDriverIds.Take(SelectionCount).ToList();
            }
        }
    }

    private void OnDriverChanged(int index, string? driverId)
    {
        if (index < 0 || index >= SelectedDriverIds.Count)
        {
            return;
        }

        SelectedDriverIds[index] = driverId ?? string.Empty;
    }
}
