@using F1.Web.Models
@using System.Linq.Expressions
@using Microsoft.AspNetCore.Components

<h4 class="mt-4">Bet Strategy</h4>
<InputRadioGroup Value="@Value" ValueChanged="@ValueChanged" ValueExpression="@ValueExpression">
    @for (var index = 0; index < Options.Count; index++)
    {
        var option = Options[index];
        <div class="form-check mb-@(index == Options.Count - 1 ? "3" : "0")">
            <InputRadio id="@GetOptionId(option.BetType)" class="form-check-input" Value="option.BetType" disabled="@(IsReadOnly || !option.IsAvailable)" />
            <label class="form-check-label" for="@GetOptionId(option.BetType)">@option.Label</label>
        </div>
    }
</InputRadioGroup>

@code {
    [Parameter] public BetType Value { get; set; }
    [Parameter] public EventCallback<BetType> ValueChanged { get; set; }
    [Parameter, EditorRequired] public Expression<Func<BetType>> ValueExpression { get; set; } = default!;
    [Parameter] public bool IsReadOnly { get; set; }
    [Parameter] public IReadOnlyList<BetOption> Options { get; set; } = [];

    protected override void OnParametersSet()
    {
        if (ValueExpression is null)
        {
            throw new InvalidOperationException("BetStrategySelector requires a non-null ValueExpression. Use @bind-Value or provide ValueExpression explicitly.");
        }

        if (Options.Count == 0)
        {
            throw new InvalidOperationException("BetStrategySelector requires at least one configured bet option.");
        }
    }

    private static string GetOptionId(BetType betType)
    {
        return $"strategy-{betType.ToString().ToLowerInvariant()}";
    }
}
